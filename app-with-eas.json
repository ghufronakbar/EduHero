{
    "expo": {
        "name": "EduHero",
        "slug": "EduHero",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon-new.png",
        "scheme": "eduhero",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground-new.png",
                "backgroundImage": "./assets/images/android-icon-background-new.png",
                "monochromeImage": "./assets/images/android-icon-monochrome-new.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.lanstheprodigy.EduHero"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon-new.png"
        },
        "plugins": [
            "expo-router",
            "expo-sqlite"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "90e0dba0-30ed-4a5c-a2ec-49c73436750f"
            }
        }
    }
}